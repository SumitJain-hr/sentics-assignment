    <script>
        // --- ANIMATION LOGIC ---

        // 1. Hero Staggered Fade-In on Load
        function staggerHero() {
            document.querySelectorAll('.hero-stagger-initial').forEach(el => {
                // Ensure a small delay for the browser to render before applying the transition
                setTimeout(() => {
                    el.classList.add('is-loaded');
                }, 50); 
            });
        }
        window.addEventListener('load', staggerHero);

        // 2. Number Counting Animation (Utility Function)
        const animateValue = (obj, end, duration, decimalPlaces = 0, prefix = "", suffix = "") => {
            let startTimestamp = null;
            // Get the starting value from the element content (should be 0)
            const start = parseFloat(obj.textContent) || 0; 
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                
                let currentValue = start + progress * (end - start);
                
                // Formatting for decimal places
                if (decimalPlaces > 0) {
                    // decimalPlaces is now correctly passed as a number between 0 and 100
                    obj.textContent = prefix + currentValue.toFixed(decimalPlaces) + suffix;
                } else {
                    obj.textContent = prefix + Math.floor(currentValue) + suffix;
                }

                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    // Ensure the final value is exactly the target
                    obj.textContent = prefix + end.toFixed(decimalPlaces) + suffix;
                }
            };
            window.requestAnimationFrame(step);
        };
        
        // 3. Intersection Observer Setup (for scroll-fade and stats count)
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // Handle Fade-In-Up animation
                    if (entry.target.classList.contains('fade-in-up')) {
                        entry.target.classList.add('is-visible');
                    }
                    
                    // Handle Stats Counting animation (only if it's the stats section)
                    if (entry.target.hasAttribute('data-stats-section')) {
                        entry.target.querySelectorAll('[data-stat-target]').forEach(stat => {
                            const target = parseFloat(stat.getAttribute('data-stat-target'));
                            const duration = parseInt(stat.getAttribute('data-stat-duration'));
                            const decimal = parseInt(stat.getAttribute('data-stat-decimal')) || 0;
                            const prefix = stat.getAttribute('data-stat-prefix') || "";
                            const suffix = stat.getAttribute('data-stat-suffix') || "";
                            
                            // Correct signature: (obj, end, duration, decimalPlaces, prefix, suffix)
                            animateValue(stat, target, duration, decimal, prefix, suffix);
                        });
                        // Stop observing the stats once counted
                        observer.unobserve(entry.target);
                    }
                }
            });
        }, {
            // Options: Start observing when 10% of the element is visible
            threshold: 0.1 
        });

        // Apply observer to all scroll-animated elements
        document.querySelectorAll('.fade-in-up').forEach(element => {
            observer.observe(element);
        });
        
        // Apply observer to the dedicated stats section
        document.querySelectorAll('[data-stats-section]').forEach(element => {
            observer.observe(element);
        });
        
    </script>
